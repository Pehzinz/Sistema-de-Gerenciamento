# Exemplo de variáveis para Railway ou para o ambiente do processo Java.
# O Spring não carrega este arquivo .env automaticamente.
PORT=8080
DB_URL=jdbc:postgresql://SEU_POOLER.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/app/certs/supabase-ca.crt
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUBSTITUIR
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_BYTES
CORS_ALLOWED_ORIGINS=https://SEU_FRONTEND.up.railway.app
# Regex dos endereços dos proxies de entrada confiáveis. Sem proxy, deixe o padrão.
TRUSTED_PROXY_PATTERN=(?!)
CLOUDINARY_CLOUD_NAME=SUBSTITUIR
CLOUDINARY_API_KEY=SUBSTITUIR
CLOUDINARY_API_SECRET=SUBSTITUIR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_ENABLED=false
# Apenas se habilitar o bot. Cada conversa privada exige login com CNPJ, CPF e senha.
BOT_TOKEN=
